# runtime output
__pycache__/
*.pyc
.ruff_cache/

# standalone build output: the PyInstaller work folder, the exe folder, the zip
# handed to testers, and the generated spec/manifest files. The release build is
# published on the Releases page, never committed here.
build/
dist/
*.spec
*.manifest
*.whl
.cache/
# data/ is runtime state (your collected games, your generated feed) and stays
# out - EXCEPT the community hero tips, which are written text that ships with
# the tool. Written as data/* so the two files below can be un-ignored: git
# never looks inside a directory that is itself excluded.
data/*
!data/hero_tips.json
!data/hero_tips.schema.json
tests/.livetest/
.overlay.json
overlay_out.log
overlay_err.log
fetch_art.log

# card art is fetched, not shipped (python fetch_art.py)
assets/

# the memory reader is a knowing opt-in build (native/msync); the compiled
# binary is not shipped
native/msync/bin/
native/msync/obj/

# the old memory reader is retired; any local leftovers stay out
vendor/
launch_out.log
launch_err.log

# your personal stats configuration - never committed
sources.json

# aggregator runtime state (server/) - the DB, the generated feed, the secret.
# server/data is already covered by data/ above; listed here for clarity.
server/data/
server/out/
server/.env

# local notes
EMAIL_FIRESTONE.md
