# runtime output
__pycache__/
*.pyc
.ruff_cache/

# standalone build output: the PyInstaller work folder, the exe folder, the zip
# handed to testers, and the generated spec/manifest files. The release build is
# published on the Releases page, never committed here.
build/
dist/
*.spec
# ...except OUR spec, which is authored, not generated: it is the build's
# source of truth (what gets bundled, which data files must exist), and
# without it in the repo nobody else can build the release at all.
!bgtracker.spec
*.manifest
*.whl
.cache/
# data/ is runtime state (your collected games, your generated feed) and stays
# out - EXCEPT the community hero tips and the comp roles, which are written
# text that ships with the tool. Written as data/* so the files below can be
# un-ignored: git never looks inside a directory that is itself excluded.
data/*
!data/hero_tips.json
!data/hero_tips.schema.json
!data/comp_roles.json
# ...and the painted skin: generated art that ships with the tool, plus the
# exe icon baked from it (tools/make_skin.py writes both), and the designed
# UI emblems (tools/make_ui_icons.py) - original chrome, safe to publish.
!data/skin/
!data/ui/
!data/app.ico
tests/.livetest/
.overlay.json
overlay_out.log
overlay_err.log
fetch_art.log

# card art is fetched, not shipped (python fetch_art.py)
assets/

# the memory reader is a knowing opt-in build (native/msync); the compiled
# binary is not shipped
native/msync/bin/
native/msync/obj/

# the old memory reader is retired; any local leftovers stay out
vendor/
launch_out.log
launch_err.log

# your personal stats configuration - never committed
sources.json

# your settings panel choices (scale, what to show, the sharing switch). Runtime
# state, and it can hold the address of a feed you run yourself.
settings.json

# aggregator runtime state (server/) - the DB, the generated feed, the secret.
# server/data is already covered by data/ above; listed here for clarity.
server/data/
server/out/
server/.env

# local notes
EMAIL_FIRESTONE.md


# the manifest signing key: the private half never goes in the repository
manifest_signing_key.pem

# local working doc for HUD asset generation - not repo material
HUD_GENERATION_BRIEF.md
assets_hud_raw/
