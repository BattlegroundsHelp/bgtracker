# Copy to /etc/bgtracker.env and edit. Read by both systemd units.
BGTRACKER_DB=/opt/bgtracker/server/data/games.db
BGTRACKER_OUT=/opt/bgtracker/server/out
BGTRACKER_BIND=127.0.0.1
BGTRACKER_PORT=8787

# Optional: require this header (X-Upload-Token) on /upload. Generate with:
#   openssl rand -hex 16
# BGTRACKER_UPLOAD_TOKEN=change-me

# Optional: cut-off date for the "last-patch" window (else a rolling 14 days).
# BGTRACKER_PATCH_DATE=2026-08-05

# Optional: uploads per minute per IP (default 120).
# BGTRACKER_RATE=120
